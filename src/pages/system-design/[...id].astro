---
import { Tusss } from "@/configs";
import LayoutArticle from "@/layouts/article.astro";
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";

type Props = Parameters<typeof LayoutArticle>[0];

export const getStaticPaths = (async () => {
  const articles = await getCollection("articles.system-design");
  return articles.map((article) => ({ params: { id: article.id } }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;

const article = await getEntry("articles.system-design", id);
if (!article) return Astro.redirect("/404");

const { Content, remarkPluginFrontmatter, headings } = await render(article);

if (!remarkPluginFrontmatter.title?.includes("System Designs")) {
  remarkPluginFrontmatter.title = `System Designs | ${remarkPluginFrontmatter.title}`;
}
remarkPluginFrontmatter.url = `${Tusss.site.url}/system-design/${id}`;
---

<LayoutArticle
  {...Astro.props}
  frontmatter={{
    ...Astro.props.frontmatter,
    ...remarkPluginFrontmatter,
    catalog_id: "system-design",
  }}
  headings={headings}
>
  <Content />
</LayoutArticle>
